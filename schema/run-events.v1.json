          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "agent",
            "default"
          ]
