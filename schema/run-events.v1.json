  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "t": {
          "type": "string"
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z]*(\\.[a-z][a-zA-Z]*)*$"
        }
      },
      "required": [
        "v",
        "seq",
        "t",
        "ms",
        "type"
      ],
      "additionalProperties": {}
    },
    "run.start": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "templateVersion": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {}
        },
        "type": {
          "const": "run.start"
        }
      },
      "required": [
        "runId",
        "templateId",
        "templateVersion",
        "steps"
      ],
      "additionalProperties": {}
    },
    "run.end": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failed"
          ]
        },
        "durationMs": {
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "run.end"
        }
      },
      "required": [
        "status",
        "durationMs"
      ],
      "additionalProperties": {}
    },
    "step.start": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "type": {
          "const": "step.start"
        }
      },
      "required": [
        "step",
        "path",
        "stepId",
        "action"
      ],
      "additionalProperties": {}
    },
    "step.retry": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": {}
        },
        "type": {
          "const": "step.retry"
        }
      },
      "required": [
        "step",
        "path",
        "attempt",
        "error"
      ],
      "additionalProperties": {}
    },
    "step.end": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "soft-failed",
            "skipped",
            "paused"
          ]
        },
        "durationMs": {
          "type": "number"
        },
        "type": {
          "const": "step.end"
        }
      },
      "required": [
        "step",
        "path",
        "stepId",
        "action",
        "status",
        "durationMs"
      ],
      "additionalProperties": {}
    },
    "loop.iteration": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "loop.iteration"
        }
      },
      "required": [
        "path",
        "index"
      ],
      "additionalProperties": {}
    },
    "data": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "save",
            "append",
            "collect"
          ]
        },
        "added": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "data"
        }
      },
      "required": [
        "path",
        "mode",
        "added"
      ],
      "additionalProperties": {}
    },
    "page.navigated": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "type": {
          "const": "page.navigated"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": {}
    },
    "page.viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "type": {
          "const": "page.viewport"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": {}
    },
    "pointer.move": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "type": {
          "const": "pointer.move"
        }
      },
      "required": [
        "x",
