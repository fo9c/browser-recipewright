{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fo9c/browser-recipewright/main/schema/run-events.v1.json",
  "title": "browser-recipewright run event (recipewright.run v1), one line of events.jsonl",
  "description": "Every line matches the envelope. Lines whose \"type\" is listed also match that type. Unknown types and extra fields are allowed: ignore them.",
  "allOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.start"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/run.start"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.end"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/run.end"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "step.start"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/step.start"
      }
