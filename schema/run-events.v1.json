          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/step.end"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "loop.iteration"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/loop.iteration"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "data"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/data"
