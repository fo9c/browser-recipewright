    {
      "if": {
        "properties": {
          "type": {
            "const": "pointer.move"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/pointer.move"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "pointer.click"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/pointer.click"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "pointer.wheel"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/pointer.wheel"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "key.type"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/key.type"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "handoff.start"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/handoff.start"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "handoff.end"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/handoff.end"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact"
