    "handoff.end": {
      "type": "object",
      "properties": {
        "waitedMs": {
          "type": "number"
        },
        "resolved": {
          "type": "boolean"
        },
        "type": {
          "const": "handoff.end"
        }
      },
      "required": [
        "waitedMs",
        "resolved"
      ],
      "additionalProperties": {}
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "type": {
          "const": "artifact"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "additionalProperties": {}
    },
    "dialog": {
      "type": "object",
      "properties": {
        "dialogType": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "dismiss"
