{
  "name": "browser-recipewright",
  "version": "0.1.2",
  "description": "AI writes the recipe, the browser follows it: AI-authored, reusable browser recipes (declarative JSON) replayed in real Chrome with human-like, low-signature input, step records and scoped self-repair.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fo9c/browser-recipewright.git"
  },
  "homepage": "https://github.com/fo9c/browser-recipewright#readme",
  "keywords": [
    "browser-automation",
    "agent",
    "skill",
    "claude-code",
    "patchright",
    "cdp",
    "workflow",
    "scraping",
    "rpa",
    "recipes"
  ],
  "bin": {
    "browser-recipewright": "bin/browser-recipewright.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "scripts",
    "schema",
    "skills",
    "demo-site",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepare": "tsc -p .",
    "test": "node --test tests/unit.test.mjs tests/e2e.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "schema": "node bin/browser-recipewright.js schema > schema/template.v0.json",
    "validate:templates": "node tools/validate-templates.mjs"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "patchright": "^1.64.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
