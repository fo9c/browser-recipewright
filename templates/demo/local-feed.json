{
  "$schema": "https://raw.githubusercontent.com/fo9c/browser-recipewright/main/schema/template.v0.json",
  "id": "demo/local-feed",
  "version": "0.1.0",
  "title": "Demo: search the bundled offline feed and read N qualifying posts with replies",
  "description": "Search a generated social-style feed on the local demo site (browser-recipewright demo). Use it to check your install and to practise snapshot / act / patch.",
  "tags": [
    "demo",
    "offline"
  ],
  "site": [
    "127.0.0.1",
    "localhost"
  ],
  "account": {
    "platform": "demo",
    "checkUrl": "{{inputs.base}}/home.html",
    "loginCheck": {
      "exists": [
        {
          "testid": "account-menu"
        }
      ]
    }
  },
  "inputs": {
    "base": {
      "type": "string",
      "default": "http://127.0.0.1:4173",
      "description": "demo site URL"
    },
    "keyword": {
      "type": "string",
      "default": "agent",
      "description": "search keyword"
    },
    "tab": {
      "type": "string",
      "enum": [
        "top",
        "live"
      ],
      "default": "top",
      "description": "top = 热门, live = 最新 (Latest posts rarely have many likes yet)"
    },
    "count": {
      "type": "integer",
      "default": 5,
      "description": "要找多少条达标帖子"
    },
    "minLikes": {
      "type": "integer",
      "default": 100,
      "description": "点赞数门槛"
    },
    "maxComments": {
      "type": "integer",
      "default": 10,
      "description": "每条帖子最多读多少条评论"
    }
  },
  "defaults": {
    "timeoutMs": 10000,
    "stepGapMs": [
      100,
      300
    ],
    "humanize": true,
    "screenshots": "failure"
  },
  "steps": [
    {
      "id": "open-search",
      "action": "goto",
      "note": "直接打开搜索结果页（比点搜索框步骤少、更稳）",
      "url": "{{inputs.base}}/search.html?q={{inputs.keyword | urlencode}}&f={{inputs.tab}}",
      "expect": {
        "exists": [
          {
            "testid": "post"
          },
          {
            "css": "article[role=article]"
          }
        ]
      }
    },
    {
      "id": "close-banner",
      "action": "click",
      "note": "关掉可能出现的 cookie 横幅（没有就跳过）",
      "target": [
        {
          "testid": "cookie-accept"
        },
        {
          "role": "button",
          "name": "Accept all"
        }
      ],
      "optional": true,
      "timeoutMs": 3000,
      "expect": {
        "notExists": [
          {
            "testid": "cookie-accept"
          }
        ]
      }
    },
    {
      "id": "collect-posts",
      "action": "collect",
      "note": "边滚动边收集帖子，只保留点赞数达标的（屏幕外的帖子会被页面移除，所以必须边滚边收）",
      "item": [
        {
          "testid": "post"
        },
        {
          "css": "article[role=article]"
        }
      ],
      "fields": {
        "url": {
          "target": [
            {
              "css": "a[href*='/status/']:has(time)"
            },
            {
              "css": "a[href*='/status/']"
            }
          ],
          "attr": "href",
          "pattern": "(/[^/]+/status/\\d+)"
        },
        "author": {
          "target": [
            {
              "testid": "author"
            }
          ],
          "text": true
        },
        "text": {
          "target": [
            {
              "testid": "post-text"
            }
          ],
          "text": true,
          "optional": true
        },
        "time": {
          "target": [
            {
              "css": "time"
            }
          ],
          "attr": "datetime",
          "optional": true
        },
        "likes": {
          "target": [
            {
              "testid": "like"
            },
            {
              "testid": "unlike"
            }
          ],
          "attr": "aria-label",
          "pattern": "^([\\d,.]+\\s*[KMB万亿千]?)",
          "as": "count",
          "optional": true,
          "default": 0
        }
      },
      "dedupeBy": "url",
      "filter": {
        "gte": [
          "{{item.likes}}",
          "{{inputs.minLikes}}"
        ]
      },
      "until": {
        "countGte": [
          "{{self}}",
          "{{inputs.count}}"
        ]
      },
      "limit": "{{inputs.count}}",
      "maxScrolls": 30,
      "saveAs": "posts"
    },
    {
      "id": "enough-posts",
      "action": "assert",
      "note": "数量不足时记录 NOT_ENOUGH_RESULTS，但继续读已找到的帖子",
      "that": {
        "countGte": [
          "{{vars.posts}}",
          "{{inputs.count}}"
        ]
      },
      "code": "NOT_ENOUGH_RESULTS",
      "optional": true
    },
    {
      "id": "read-each",
      "action": "forEach",
      "note": "逐条打开帖子，读正文和评论；某一条失败（如帖子被删）不影响其他条",
      "in": "{{vars.posts}}",
      "as": "post",
      "max": 20,
      "continueOnError": true,
      "do": [
        {
          "id": "open-post",
          "action": "goto",
          "url": "{{inputs.base}}{{post.url}}",
          "expect": {
            "and": [
              {
                "urlContains": "/status/"
              },
              {
                "exists": [
                  {
                    "testid": "post"
                  },
                  {
                    "css": "article[role=article]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "read-main",
          "action": "read",
          "note": "帖子详情页第一条就是主帖",
          "target": [
            {
              "testid": "post",
              "nth": 0
            },
            {
              "css": "article[role=article]",
              "nth": 0
            }
          ],
          "fields": {
            "author": {
              "target": [
                {
                  "testid": "author"
                }
              ],
              "text": true,
              "optional": true
            },
            "text": {
              "target": [
                {
                  "testid": "post-text"
                }
              ],
              "text": true,
              "optional": true
            },
            "time": {
              "target": [
                {
                  "css": "time"
                }
              ],
              "attr": "datetime",
              "optional": true
            }
          },
          "saveAs": "main"
        },
        {
          "id": "collect-replies",
          "action": "collect",
          "note": "跳过第 1 条（主帖），向下滚动收集评论",
          "item": [
            {
              "testid": "post"
            },
            {
              "css": "article[role=article]"
            }
          ],
          "offset": 1,
          "fields": {
            "url": {
              "target": [
                {
                  "css": "a[href*='/status/']:has(time)"
                },
                {
                  "css": "a[href*='/status/']"
                }
              ],
              "attr": "href",
              "pattern": "(/[^/]+/status/\\d+)"
            },
            "author": {
              "target": [
                {
                  "testid": "author"
                }
              ],
              "text": true,
              "optional": true
            },
            "text": {
              "target": [
                {
                  "testid": "post-text"
                }
              ],
              "text": true,
              "optional": true
            },
            "likes": {
              "target": [
                {
                  "testid": "like"
                },
                {
                  "testid": "unlike"
                }
              ],
              "attr": "aria-label",
              "pattern": "^([\\d,.]+\\s*[KMB万亿千]?)",
              "as": "count",
              "optional": true,
              "default": 0
            }
          },
          "dedupeBy": "url",
          "limit": "{{inputs.maxComments}}",
          "maxScrolls": 10,
          "saveAs": "replies"
        },
        {
          "id": "rest",
          "action": "wait",
          "note": "每条之间随机停 2–5 秒，像人一样阅读",
          "ms": [
            200,
            600
          ]
        }
      ],
      "collectFrom": {
        "post": "{{post}}",
        "main": "{{vars.main}}",
        "replies": "{{vars.replies}}"
      },
      "saveAs": "details"
    }
  ],
  "outputs": {
    "from": "{{vars.details}}",
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "post",
          "main",
          "replies"
        ]
      }
    }
  },
  "provenance": {
    "source": "offline demo recipe"
  }
}
