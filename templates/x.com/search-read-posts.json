{
  "$schema": "https://raw.githubusercontent.com/fo9c/browser-recipewright/main/schema/template.v0.json",
  "id": "x.com/search-read-posts",
  "version": "0.1.0",
  "title": "在 X 上搜索关键词，读取 N 条达标帖子的正文和评论 / Search X, read N qualifying posts with replies",
  "description": "Opens X search results directly by URL, scroll-collects posts until `count` posts have at least `minLikes` likes, then opens each post and reads its text, time and up to `maxComments` replies. Read-only; uses the logged-in browser profile.",
  "tags": ["x.com", "twitter", "search", "read-only", "m1"],
  "site": ["x.com", "twitter.com"],
  "account": {
    "platform": "x.com",
    "checkUrl": "https://x.com/home",
    "loginUrl": "https://x.com/i/flow/login",
    "loginCheck": {
      "or": [
        { "exists": [{ "testid": "SideNav_AccountSwitcher_Button" }] },
        { "exists": [{ "testid": "AppTabBar_Profile_Link" }] }
      ]
    }
  },
  "inputs": {
    "keyword": { "type": "string", "description": "搜索词 / search keyword" },
    "tab": { "type": "string", "enum": ["top", "live"], "default": "top", "description": "top = 热门, live = 最新 (Latest posts rarely have many likes yet)" },
    "count": { "type": "integer", "default": 5, "description": "要找多少条达标帖子" },
    "minLikes": { "type": "integer", "default": 50, "description": "点赞数门槛" },
    "maxComments": { "type": "integer", "default": 20, "description": "每条帖子最多读多少条评论" }
  },
  "defaults": { "timeoutMs": 15000, "stepGapMs": [400, 1200], "humanize": true, "screenshots": "failure" },
  "steps": [
    {
      "id": "open-search",
      "action": "goto",
      "note": "直接打开搜索结果页（比点搜索框步骤少、更稳）",
      "url": "https://x.com/search?q={{inputs.keyword | urlencode}}&src=typed_query&f={{inputs.tab}}",
      "expect": { "exists": [{ "testid": "tweet" }, { "css": "article[role=article]" }] }
    },
    {
      "id": "collect-posts",
      "action": "collect",
      "note": "边滚动边收集帖子，只保留点赞数达标的（屏幕外的帖子会被 X 从页面移除，所以必须边滚边收）",
      "item": [{ "testid": "tweet" }, { "css": "article[role=article]" }],
      "fields": {
        "url": { "target": [{ "css": "a[href*='/status/']:has(time)" }, { "css": "a[href*='/status/']" }], "attr": "href", "pattern": "^(?:https://(?:x|twitter)\\.com)?(/[^/]+/status/\\d+)" },
        "author": { "target": [{ "testid": "User-Name" }], "text": true },
        "text": { "target": [{ "testid": "tweetText" }], "text": true, "optional": true },
        "time": { "target": [{ "css": "time" }], "attr": "datetime", "optional": true },
        "likes": { "target": [{ "testid": "like" }, { "testid": "unlike" }], "attr": "aria-label", "pattern": "^([\\d,.]+\\s*[KMB万亿千]?)", "as": "count", "optional": true, "default": 0 }
      },
      "dedupeBy": "url",
      "filter": { "gte": ["{{item.likes}}", "{{inputs.minLikes}}"] },
      "until": { "countGte": ["{{self}}", "{{inputs.count}}"] },
      "limit": "{{inputs.count}}",
      "maxScrolls": 40,
      "saveAs": "posts"
    },
    {
      "id": "enough-posts",
      "action": "assert",
      "note": "数量不足时记录 NOT_ENOUGH_RESULTS，但继续读已找到的帖子",
      "that": { "countGte": ["{{vars.posts}}", "{{inputs.count}}"] },
      "code": "NOT_ENOUGH_RESULTS",
      "optional": true
    },
    {
      "id": "read-each",
      "action": "forEach",
      "note": "逐条打开帖子，读正文和评论；某一条失败（如帖子被删）不影响其他条",
      "in": "{{vars.posts}}",
      "as": "post",
      "max": 20,
      "continueOnError": true,
      "do": [
        {
          "id": "open-post",
          "action": "goto",
          "url": "https://x.com{{post.url}}",
          "expect": { "and": [{ "urlContains": "/status/" }, { "exists": [{ "testid": "tweet" }, { "css": "article[role=article]" }] }] }
        },
        {
          "id": "read-main",
          "action": "read",
          "note": "帖子详情页第一个 tweet 就是主帖",
          "target": [{ "testid": "tweet", "nth": 0 }, { "css": "article[role=article]", "nth": 0 }],
          "fields": {
            "author": { "target": [{ "testid": "User-Name" }], "text": true, "optional": true },
            "text": { "target": [{ "testid": "tweetText" }], "text": true, "optional": true },
            "time": { "target": [{ "css": "time" }], "attr": "datetime", "optional": true }
          },
          "saveAs": "main"
        },
        {
          "id": "collect-replies",
          "action": "collect",
          "note": "跳过第 1 条（主帖），向下滚动收集评论",
          "item": [{ "testid": "tweet" }, { "css": "article[role=article]" }],
          "offset": 1,
          "fields": {
            "url": { "target": [{ "css": "a[href*='/status/']:has(time)" }, { "css": "a[href*='/status/']" }], "attr": "href", "pattern": "(/[^/]+/status/\\d+)" },
            "author": { "target": [{ "testid": "User-Name" }], "text": true, "optional": true },
            "text": { "target": [{ "testid": "tweetText" }], "text": true, "optional": true },
            "likes": { "target": [{ "testid": "like" }, { "testid": "unlike" }], "attr": "aria-label", "pattern": "^([\\d,.]+\\s*[KMB万亿千]?)", "as": "count", "optional": true, "default": 0 }
          },
          "dedupeBy": "url",
          "limit": "{{inputs.maxComments}}",
          "maxScrolls": 10,
          "saveAs": "replies"
        },
        { "id": "rest", "action": "wait", "note": "每条之间随机停 2–5 秒，像人一样阅读", "ms": [2000, 5000] }
      ],
      "collectFrom": { "post": "{{post}}", "main": "{{vars.main}}", "replies": "{{vars.replies}}" },
      "saveAs": "details"
    }
  ],
  "outputs": {
    "from": "{{vars.details}}",
    "schema": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["post", "main", "replies"] } }
  },
  "provenance": { "source": "hand-written from the v0 format spec", "createdAt": "2026-11-22" }
}
